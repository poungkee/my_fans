# ================================
# FANS 프로젝트 환경변수 템플릿
# ================================
# 이 파일을 복사하여 .env, .env.local, .env.ecs, .env.eks 파일을 생성하세요
#
# 로컬 개발: .env.local로 복사
# ECS 배포: .env.ecs로 복사
# EKS 배포: .env.eks로 복사
#
# 중요: 실제 값을 입력한 .env 파일은 절대 커밋하지 마세요!
# ================================

# ================================
# Core Service Configuration
# ================================
NODE_ENV=development
PORT=3000

# ================================
# Database Configuration
# ================================
# 로컬: postgres (Docker Compose 서비스명)
# ECS/EKS: RDS 엔드포인트 입력
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=fans_user
DB_PASSWORD=CHANGE_THIS_PASSWORD
DB_NAME=fans_db

# PostgreSQL Docker Configuration
POSTGRES_DB=fans_db
POSTGRES_USER=fans_user
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD

# ================================
# AI Services Configuration
# ================================
# 로컬: Docker Compose 서비스명
# ECS: Service Discovery URL (예: summarize-ai.fans.local:8000)
# EKS: Kubernetes DNS (예: summarize-ai.fans-svc.svc.cluster.local:8000)
AI_SERVICE_URL=http://summarize-ai:8000
SUMMARIZE_AI_URL=http://summarize-ai:8000
BIAS_AI_URL=http://bias-analysis-ai:8002
BIAS_ANALYSIS_AI_URL=http://bias-analysis-ai:8002
CLASSIFICATION_API_URL=http://classification-api:5000

SUMMARIZE_AI_PORT=8000
BIAS_ANALYSIS_AI_PORT=8002
CLASSIFICATION_API_PORT=5000

# AI Model Configuration
MODEL_NAME=eenzeenee/t5-base-korean-summarization
MAX_SUMMARY_LENGTH=100

# ================================
# Crawler Services Configuration
# ================================
UNIFIED_CRAWLER_PORT=4007
RSS_CRAWLER_PORT=4002
API_CRAWLER_PORT=4003
PUPPETEER_CRAWLER_PORT=4004

# Crawler Settings
AUTO_CRAWL=true
CRAWL_INTERVAL=180000
CRAWL_INTERVAL_MINUTES=30
CRAWL_LIMIT_PER_CATEGORY=20

# Puppeteer Load Balancing
TOTAL_REPLICAS=1
INSTANCE_ID=0
TOTAL_INSTANCES=1

# ================================
# Scheduler Configuration
# ================================
SCHEDULE_INTERVAL=*/10 * * * *
RUN_ON_START=false
RAW_NEWS_BATCH_SIZE=100
SUMMARY_BATCH_SIZE=50

# ================================
# Frontend Configuration
# ================================
# 로컬: localhost
# ECS/EKS: 실제 도메인
FRONTEND_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# React Environment Variables
REACT_APP_API_BASE=http://localhost:3000
REACT_APP_API_URL=http://localhost:3000/api
REACT_APP_AI_SERVICE_URL=http://localhost:8000

# ================================
# OAuth Configuration
# ================================
# 실제 Kakao/Naver 개발자 콘솔에서 발급받은 값으로 변경하세요
# Kakao Login
KAKAO_CLIENT_ID=YOUR_KAKAO_CLIENT_ID
KAKAO_CLIENT_SECRET=YOUR_KAKAO_CLIENT_SECRET
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback

# Naver Login
NAVER_CLIENT_ID=YOUR_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET
NAVER_REDIRECT_URI=http://localhost:3000/api/auth/naver/callback

# ================================
# Naver Search API (for News Crawling)
# ================================
NAVER_SEARCH_CLIENT_ID=YOUR_NAVER_SEARCH_CLIENT_ID
NAVER_SEARCH_CLIENT_SECRET=YOUR_NAVER_SEARCH_CLIENT_SECRET

# Second Set for Load Balancing (선택사항)
NAVER_CLIENT_ID_2=YOUR_NAVER_CLIENT_ID_2
NAVER_CLIENT_SECRET_2=YOUR_NAVER_CLIENT_SECRET_2

# ================================
# Security Configuration
# ================================
# 운영 환경에서는 반드시 강력한 랜덤 문자열로 변경하세요!
JWT_SECRET=CHANGE_THIS_TO_STRONG_RANDOM_STRING
SESSION_SECRET=CHANGE_THIS_TO_STRONG_RANDOM_STRING

# ================================
# Email Service Configuration
# ================================
# SMTP 이메일 서비스 설정
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password

# ================================
# Optional Configuration
# ================================
LOG_LEVEL=info
